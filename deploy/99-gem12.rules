# Stable device names for the GEM12+ status display and MAFP touch sensor.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0416", ATTRS{idProduct}=="90a1", SYMLINK+="gem12-lcd", GROUP="dialout", MODE="0660"
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="3274", ATTR{idProduct}=="8012", SYMLINK+="gem12-fingerprint", MODE="0660", TAG+="systemd", ENV{SYSTEMD_WANTS}+="gem12-usb-rebind.service"
